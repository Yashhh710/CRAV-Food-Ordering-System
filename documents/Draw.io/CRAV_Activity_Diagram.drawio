<mxfile host="app.diagrams.net"><diagram name="CRAV Activity" id="d1"><mxGraphModel dx="2560" dy="1440" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2620" pageHeight="1500" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="a1" value="Activity Diagram for CRAV Food Ordering System" style="fontFamily=Helvetica;text;html=1;align=center;verticalAlign=middle;fontSize=30;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="694" y="32" width="1200" height="60" as="geometry"/></mxCell><mxCell id="a2" value="" style="fontFamily=Helvetica;line;strokeWidth=1;html=1;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="117" y="105" width="2354" height="2" as="geometry"/></mxCell><mxCell id="a3" value="" style="fontFamily=Helvetica;ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="81" y="262" width="30" height="30" as="geometry"/></mxCell><mxCell id="a4" value="1. Customer opens&lt;br&gt;CRAV website" style="fontFamily=Helvetica;rounded=1;arcSize=25;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=17;" vertex="1" parent="1"><mxGeometry x="164" y="237" width="196" height="80" as="geometry"/></mxCell><mxCell id="a5" value="2. Browse food menu" style="fontFamily=Helvetica;rounded=1;arcSize=25;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=17;" vertex="1" parent="1"><mxGeometry x="410" y="237" width="175" height="80" as="geometry"/></mxCell><mxCell id="a6" value="3. Select food items" style="fontFamily=Helvetica;rounded=1;arcSize=25;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=17;" vertex="1" parent="1"><mxGeometry x="624" y="237" width="175" height="80" as="geometry"/></mxCell><mxCell id="a7" value="4. Customize food items&lt;br&gt;(optional)" style="fontFamily=Helvetica;rounded=1;arcSize=25;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=17;" vertex="1" parent="1"><mxGeometry x="825" y="237" width="201" height="80" as="geometry"/></mxCell><mxCell id="a8" value="5. Add items to cart" style="fontFamily=Helvetica;rounded=1;arcSize=25;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=17;" vertex="1" parent="1"><mxGeometry x="1073" y="237" width="175" height="80" as="geometry"/></mxCell><mxCell id="a9" value="6. Review cart and&lt;br&gt;proceed to checkout" style="fontFamily=Helvetica;rounded=1;arcSize=25;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=17;" vertex="1" parent="1"><mxGeometry x="1292" y="237" width="218" height="80" as="geometry"/></mxCell><mxCell id="a10" value="7. Enter delivery address&lt;br&gt;and contact details" style="fontFamily=Helvetica;rounded=1;arcSize=25;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=17;" vertex="1" parent="1"><mxGeometry x="1552" y="237" width="223" height="80" as="geometry"/></mxCell><mxCell id="a11" value="Are all ordered&lt;br&gt;items available?" style="fontFamily=Helvetica;rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=17;spacing=0;" vertex="1" parent="1"><mxGeometry x="1864" y="210" width="219" height="133" as="geometry"/></mxCell><mxCell id="a12" value="Show unavailable item&lt;br&gt;message" style="fontFamily=Helvetica;rounded=1;arcSize=25;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=17;" vertex="1" parent="1"><mxGeometry x="1854" y="471" width="239" height="80" as="geometry"/></mxCell><mxCell id="a13" value="Update cart or remove&lt;br&gt;unavailable items" style="fontFamily=Helvetica;rounded=1;arcSize=25;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=17;" vertex="1" parent="1"><mxGeometry x="1849" y="607" width="249" height="85" as="geometry"/></mxCell><mxCell id="a14" value="9. Select payment method" style="fontFamily=Helvetica;rounded=1;arcSize=25;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=17;" vertex="1" parent="1"><mxGeometry x="1520" y="810" width="244" height="85" as="geometry"/></mxCell><mxCell id="a15" value="Is payment&lt;br&gt;successful?" style="fontFamily=Helvetica;rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=17;spacing=0;" vertex="1" parent="1"><mxGeometry x="1180" y="785" width="218" height="133" as="geometry"/></mxCell><mxCell id="a16" value="11. Place order and&lt;br&gt;generate Order ID" style="fontFamily=Helvetica;rounded=1;arcSize=25;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=17;" vertex="1" parent="1"><mxGeometry x="763" y="810" width="238" height="85" as="geometry"/></mxCell><mxCell id="a17" value="12. Kitchen receives and&lt;br&gt;prepares the order" style="fontFamily=Helvetica;rounded=1;arcSize=25;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=17;" vertex="1" parent="1"><mxGeometry x="763" y="969" width="238" height="85" as="geometry"/></mxCell><mxCell id="a18" value="13. Order is packed" style="fontFamily=Helvetica;rounded=1;arcSize=25;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=17;" vertex="1" parent="1"><mxGeometry x="763" y="1131" width="238" height="81" as="geometry"/></mxCell><mxCell id="a19" value="14. Order is handed over&lt;br&gt;to delivery partner" style="fontFamily=Helvetica;rounded=1;arcSize=25;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=17;" vertex="1" parent="1"><mxGeometry x="448" y="1129" width="249" height="85" as="geometry"/></mxCell><mxCell id="a20" value="15. Delivery partner&lt;br&gt;delivers the order" style="fontFamily=Helvetica;rounded=1;arcSize=25;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=17;" vertex="1" parent="1"><mxGeometry x="140" y="1129" width="244" height="85" as="geometry"/></mxCell><mxCell id="a21" value="16. Customer receives&lt;br&gt;the order" style="fontFamily=Helvetica;rounded=1;arcSize=25;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=17;" vertex="1" parent="1"><mxGeometry x="140" y="1286" width="244" height="80" as="geometry"/></mxCell><mxCell id="a22" value="" style="fontFamily=Helvetica;ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;strokeWidth=2;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="242" y="1389" width="40" height="40" as="geometry"/></mxCell><mxCell id="a23" value="END" style="fontFamily=Helvetica;text;html=1;align=center;verticalAlign=middle;fontSize=17;" vertex="1" parent="1"><mxGeometry x="289" y="1393" width="80" height="30" as="geometry"/></mxCell><mxCell id="a24" value="Display payment failure&lt;br&gt;message" style="fontFamily=Helvetica;rounded=1;arcSize=25;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=17;" vertex="1" parent="1"><mxGeometry x="1167" y="982" width="244" height="81" as="geometry"/></mxCell><mxCell id="a25" value="Retry payment or select&lt;br&gt;another payment method" style="fontFamily=Helvetica;rounded=1;arcSize=25;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontSize=17;" vertex="1" parent="1"><mxGeometry x="1159" y="1118" width="260" height="85" as="geometry"/></mxCell><mxCell id="a26" value="" style="fontFamily=Helvetica;endArrow=classic;endFill=1;strokeColor=#000000;strokeWidth=2;html=1;rounded=0;" edge="1" parent="1" source="a4" target="a5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a27" value="" style="fontFamily=Helvetica;endArrow=classic;endFill=1;strokeColor=#000000;strokeWidth=2;html=1;rounded=0;" edge="1" parent="1" source="a5" target="a6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a28" value="" style="fontFamily=Helvetica;